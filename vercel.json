{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/extract-certificate.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
